# Copy to .env and adjust. Defaults are the 100%-OSS local path.
WORLD_SEED=42
WORLD_AUTOTICK=true
PRIMARY_MODEL=qwen3:4b
FALLBACK_MODEL=qwen2.5:0.5b

# ── Failover chain backends (the rungs behind the "robot-brain" virtual model) ──
# DEFAULT is 100% reproducible with NO models and NO GPU: an "edge-sim"
# deterministic rung fails over to the "mock-llm" deterministic rung. Great for
# CI, laptops, and a hands-off demo.
PRIMARY_BASE_URL=http://mock-edge:8200/v1
FALLBACK_BASE_URL=http://mock-llm:8200/v1
#
# For REAL local inference (recommended for a live demo):
#   1) containerized Ollama (CPU-only on macOS Docker — slow):
#        make up-ollama          # starts + pulls ollama-primary/-fallback
#        PRIMARY_BASE_URL=http://ollama-primary:11434/v1
#        FALLBACK_BASE_URL=http://ollama-fallback:11434/v1
#   2) host Ollama with Metal GPU on a Mac (fast — best for the stage):
#        ollama pull qwen3:4b
#        PRIMARY_BASE_URL=http://host.docker.internal:11434/v1
# Optional cloud rung — default OFF; the demo makes a point of it.
ENABLE_CLOUD_FALLBACK=false
